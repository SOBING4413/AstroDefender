// AstroDefender Resource File
// Embeds the application icon into the .exe

#include <windows.h>

// Application icon (IDI_APPLICATION = 32512)
IDI_APPLICATION ICON "icon.ico"

// Version information block
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1, 0, 0, 0
PRODUCTVERSION  1, 0, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AstroDefender Project"
            VALUE "FileDescription",  "AstroDefender - Space Shooter"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AstroDefender"
            VALUE "OriginalFilename", "AstroDefender.exe"
            VALUE "ProductName",      "AstroDefender"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
